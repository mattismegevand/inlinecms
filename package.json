{
  "name": "inlinecms",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "typescript": "^5.8.3",
    "astro": "^5.0.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "turndown": "^7.2.0"
  },
  "scripts": {
    "build": "bun build index.ts --outfile=dist/index.js --target=node && bun build src/main.ts --outfile=dist/client.js --target=browser",
    "prepare": "bun run build",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "version": "0.2.1",
  "description": "Real-time inline CMS for Astro with post management, frontmatter editing, and live preview",
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mattismegevand/inlinecms"
  },
  "keywords": [
    "astro",
    "cms",
    "inline",
    "markdown",
    "content",
    "editor",
    "frontmatter",
    "blog"
  ],
  "author": "Mattis Megevand <mattis@megevand.dev>",
  "license": "MIT"
}
